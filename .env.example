# Airtable personal access token. Required scopes:
# data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=

# Existing Airtable base. The setup command creates/validates the table in it.
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Applications

# Optional override for mandatory container compilation.
LATEX_CONTAINER_IMAGE=docker.io/texlive/texlive:latest
